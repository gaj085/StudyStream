LLM_API_KEY=
LLM_MODEL=open-mistral-nemo
CHROMA_URL=http://localhost:8000
PORT=5000

# RAG retrieval threshold — chunks with distance >= this value are discarded
# before being sent to the LLM. Lower = stricter relevance. Default: 1.5
# Calibrate against evaluation/ dataset to find the optimal value.
RAG_DISTANCE_THRESHOLD=1.5
